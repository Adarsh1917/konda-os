# ==========================================
# Konda OS - Git Ignore
# ==========================================

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local files
*.local

# ==========================================
# Editors / IDEs
# ==========================================

.vscode/*
!.vscode/extensions.json

.idea/
.DS_Store

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln

# ==========================================
# OS generated files
# ==========================================

Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.swp
*.swo
*~

# ==========================================
# Coverage / test output
# ==========================================

coverage/
.nyc_output/

# ==========================================
# Vite / TypeScript caches
# ==========================================

.vite/
*.tsbuildinfo
